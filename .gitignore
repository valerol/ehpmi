# Operating-system and editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# WordPress core and environment-specific runtime files
/wp-admin/
/wp-includes/
/wp-config.php
/.htaccess
/wp-cli.yml

# Installed dependencies are restored from ops/plugins.yml. The project-owned
# site plugin is source code and is the only tracked plugin.
/wp-content/plugins/*
!/wp-content/plugins/ehpmi-core/
!/wp-content/plugins/ehpmi-core/**
/wp-content/mu-plugins/

# Dynamic content belongs to the verified Google Drive backup package
/wp-content/uploads/
/files/
/images/

# Local backup and secret material
/backups/
*.sql
*.sql.gz
*.tar
*.tar.gz
*.zip
*.env
*.key
*.pem
