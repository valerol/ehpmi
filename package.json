{
  "name": "ehpmi-theme-build",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible EHPMI CSS and self-hosted frontend dependencies",
  "engines": {"node": ">=20"},
  "scripts": {
    "build:css": "node ops/build/css.mjs",
    "check:css": "node ops/build/css.mjs --check",
    "check:assets": "node ops/build/vendor.mjs --check",
    "build:vendor": "node ops/build/vendor.mjs",
    "check": "npm run check:css && npm run check:assets"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "bootstrap": "5.1.3",
    "less": "4.2.2"
  }
}
