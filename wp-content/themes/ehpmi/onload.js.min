$(document).ready(function(){if(screen.width>1024){$(".dropdown-toggle").dropdown(),$(".dropdown").on("show.bs.dropdown",function(){$(this).find(".dropdown-menu").first().stop(!0,!0).slideDown()}),$(".dropdown").on("hide.bs.dropdown",function(){$(this).find(".dropdown-menu").first().stop(!0,!0).slideUp()}),$(".carousel").carousel(),$(window).on("load resize scroll",function(){$(".hero").each(function(){var t=$(window).scrollTop(),o=$(this).offset().top,e=t-o;$(this).find("img").css({"margin-top":e/5}),$(this).find(".text").css({"margin-top":10-e/10,"margin-bottom":10+e/10})}),$(".map").each(function(){var t=$(window).scrollTop(),o=$(this).offset().top,e=t-o;$(this).find(".image").css({"margin-top":250+e/5}),$(this).find(".text").css({"margin-top":e/10,"margin-bottom":10+e/10})})});var t=$(".animation-element"),o=$(window);function e(){var e=o.height(),n=o.scrollTop(),i=n+e;$.each(t,function(){var t=$(this),o=t.outerHeight(),e=t.offset().top,r=e+o;r>=n&&e<=i?t.addClass("in-view"):t.removeClass("in-view")})}o.on("scroll resize",e),o.trigger("scroll")}$(".header .search-icon").click(function(){$(".header .searchform").slideToggle()});var t=[...document.querySelectorAll(".point")];document.addEventListener("click",function(o){t.some(t=>t.contains(o.target))?t.forEach(t=>t.contains(o.target)?"":t.removeAttribute("open")):t.forEach(t=>t.removeAttribute("open"))}),$("#latest-carousel .owl-carousel").owlCarousel({margin:30,nav:!0,responsive:{0:{items:1},600:{items:3}}}),$("#testimonials-carousel .owl-carousel").owlCarousel({loop:!0,margin:50,nav:!0,responsive:{0:{items:1},721:{items:2},1025:{items:3}}}),$("#partner-carousel .owl-carousel").owlCarousel({loop:!0,margin:10,nav:!0,responsive:{0:{items:1},600:{items:3},1e3:{items:5}}})});

